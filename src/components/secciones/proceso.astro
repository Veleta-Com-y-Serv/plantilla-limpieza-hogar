---
// Cómo funciona: banda partida 50/50 con la foto a sangre a la izquierda (esquina superior derecha muy redonda)
// y los pasos numerados a la derecha, unidos por una línea lima. Sin foto, los pasos ocupan todo el ancho en
// columnas. Campos: `imagen`, `items[]` (titulo, texto, icono).
import { seccion, conTitulo } from '../../data/site';
import { altSeccion } from '../../lib/seo';
import Titular from '../ui/Titular.astro';
import Imagen from '../ui/Imagen.astro';
interface Props { id: string }
const s = seccion(Astro.props.id);
const pasos = s ? conTitulo(s.items) : [];
const hay = !!s && !!(s.titulo || s.antetitulo || s.texto || s.imagen || pasos.length);
---

{
  s && hay && (
    <section id={Astro.props.id} class:list={['banda banda--clara', { 'banda--sin-relleno': !!s.imagen }]}>
      {s.imagen ? (
        <div class="partida">
          <div class="partida-foto esquina-ad">
            <Imagen src={s.imagen} alt={altSeccion(s)} ancho={1200} alto={1100} />
          </div>
          <div class="partida-texto partida-texto--der">
            <Titular antetitulo={s.antetitulo} titulo={s.titulo} texto={s.texto} />
            {pasos.length > 0 && (
              <ol class="pasos">
                {pasos.map((p, i) => (
                  <li>
                    <span class="paso-num" aria-hidden="true">{i + 1}</span>
                    <div>
                      <h3>{p.titulo}</h3>
                      {p.texto && <p>{p.texto}</p>}
                    </div>
                  </li>
                ))}
              </ol>
            )}
          </div>
        </div>
      ) : (
        <div class="contenedor">
          <Titular antetitulo={s.antetitulo} titulo={s.titulo} texto={s.texto} />
          {pasos.length > 0 && (
            <ol class="pasos pasos--fila">
              {pasos.map((p, i) => (
                <li>
                  <span class="paso-num" aria-hidden="true">{i + 1}</span>
                  <div>
                    <h3>{p.titulo}</h3>
                    {p.texto && <p>{p.texto}</p>}
                  </div>
                </li>
              ))}
            </ol>
          )}
        </div>
      )}
    </section>
  )
}

<style>
  .pasos { display: grid; gap: 0; counter-reset: paso; }
  .pasos li { position: relative; display: grid; grid-template-columns: 3.5rem 1fr; gap: 1.25rem; padding-bottom: 2.25rem; }
  .pasos li:last-child { padding-bottom: 0; }
  .pasos:not(.pasos--fila) li:not(:last-child)::before { content: ""; position: absolute; left: calc(1.75rem - 2px); top: 3.5rem; bottom: 0; width: 4px; border-radius: 4px; background: var(--c-acento); }
  .paso-num { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 999px; background: var(--c-primario); color: #fff; font-family: var(--fuente-titulos); font-weight: 700; font-size: 1.4rem; }
  .pasos h3 { font-size: clamp(1.3rem, 2vw, 1.65rem); margin-top: .7rem; }
  .pasos p { margin-top: .5rem; opacity: .8; max-width: 34rem; }
  @media (min-width: 768px) {
    .pasos--fila { grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); gap: 2.5rem; }
    .pasos--fila li { grid-template-columns: 1fr; padding-bottom: 0; }
  }
</style>
