---
// Banda de cifras a todo el ancho en azul pleno: cifras enormes en lima separadas por juntas finas.
// Campos: `items[]` (titulo = la cifra, texto = qué mide). Sin cifras no se pinta.
import { seccion, conTitulo } from '../../data/site';
import Titular from '../ui/Titular.astro';
interface Props { id: string }
const s = seccion(Astro.props.id);
const cifras = s ? conTitulo(s.items) : [];
---

{
  s && cifras.length > 0 && (
    <section id={Astro.props.id} class="banda banda--azul overflow-hidden">
      <span class="burbuja burbuja--aro" style="width:30rem;height:30rem;right:-10rem;top:-14rem" aria-hidden="true" />
      <div class="contenedor relative">
        <Titular antetitulo={s.antetitulo} titulo={s.titulo} texto={s.texto} />
        <dl class="cifras">
          {cifras.map((c) => (
            <div>
              <dt>{c.titulo}</dt>
              {c.texto && <dd>{c.texto}</dd>}
            </div>
          ))}
        </dl>
      </div>
    </section>
  )
}

<style>
  .cifras { display: grid; grid-template-columns: repeat(2, 1fr); gap: 2.5rem 0; }
  @media (min-width: 1000px) { .cifras { grid-template-columns: repeat(4, 1fr); } }
  .cifras > div { border-left: 2px solid var(--linea); padding-left: clamp(1rem, 2.5vw, 2rem); padding-right: 1rem; }
  .cifras dt { font-family: var(--fuente-titulos); font-weight: 700; font-size: clamp(2.4rem, 5vw, 5rem); line-height: 1; letter-spacing: -0.05em; color: var(--c-acento); overflow-wrap: anywhere; }
  .cifras dd { margin-top: .6rem; font-size: clamp(.95rem, 1.4vw, 1.1rem); opacity: .9; }
</style>
