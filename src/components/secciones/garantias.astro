---
// Garantías en banda lima a todo el ancho: titular grande y las garantías en columnas (2 en tableta, 4 en
// escritorio) con icono en burbuja noche y filete superior. Campos: `items[]` (titulo, texto, icono).
import { seccion, conTitulo } from '../../data/site';
import Titular from '../ui/Titular.astro';
import Icono from '../ui/Icono.astro';
interface Props { id: string }
const s = seccion(Astro.props.id);
const items = s ? conTitulo(s.items) : [];
const hay = !!s && !!(s.titulo || s.antetitulo || s.texto || items.length);
---

{
  s && hay && (
    <section id={Astro.props.id} class="banda banda--lima overflow-hidden">
      <span class="burbuja burbuja--aro" style="width:20rem;height:20rem;right:-8rem;bottom:-12rem" aria-hidden="true" />
      <div class="contenedor relative">
        <Titular antetitulo={s.antetitulo} titulo={s.titulo} texto={s.texto} />
        {items.length > 0 && (
          <ul class="garantias">
            {items.map((it) => (
              <li>
                <span class="pastilla-icono"><Icono nombre={it.icono} tam={26} /></span>
                <h3>{it.titulo}</h3>
                {it.texto && <p>{it.texto}</p>}
              </li>
            ))}
          </ul>
        )}
      </div>
    </section>
  )
}

<style>
  .garantias { display: grid; gap: 2.5rem 2rem; }
  @media (min-width: 640px) { .garantias { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1100px) { .garantias { grid-template-columns: repeat(4, 1fr); } }
  .garantias li { border-top: 3px solid var(--sobre-acento); padding-top: 1.75rem; }
  .garantias h3 { font-size: clamp(1.3rem, 2vw, 1.6rem); margin-top: 1.25rem; }
  .garantias p { margin-top: .6rem; opacity: .85; }
</style>
